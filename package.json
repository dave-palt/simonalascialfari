{
  "name": "simona-sito",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/gen-manifest.ts && vite build && bun scripts/prerender.tsx",
    "typecheck": "tsc --noEmit",
    "gen-manifest": "bun scripts/gen-manifest.ts",
    "preview": "vite preview",
    "link-photos": "sh scripts/link-photos.sh",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "clsx": "2.1.1",
    "framer-motion": "12.35.1",
    "lucide-react": "0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.71.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "wouter": "3.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "25.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "wrangler": "^4.0.0"
  }
}
